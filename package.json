{
  "name": "ai-free-vscode",
  "displayName": "AI Free VSCode for Copilot Chat",
  "description": "Use free AI models directly in Copilot Chat",
  "version": "0.3.0",
  "publisher": "ai-free-vscode",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/AppsGanin/ai-free-vscode"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "ai-free-vscode",
        "displayName": "AI Free VSCode"
      }
    ],
    "commands": [
      {
        "command": "ai-free-vscode.login",
        "title": "AI Free VSCode — Войти (Sign In)"
      },
      {
        "command": "ai-free-vscode.logout",
        "title": "AI Free VSCode — Выйти (Sign Out)"
      },
      {
        "command": "ai-free-vscode.status",
        "title": "AI Free VSCode — Статус авторизации"
      },
      {
        "command": "ai-free-vscode.manage",
        "title": "AI Free VSCode — Управление аккаунтом"
      }
    ],
    "configuration": {
      "title": "AI Free VSCode",
      "properties": {
        "freeAI.playwright.timeout": {
          "type": "number",
          "default": 120000,
          "description": "Таймаут ожидания авторизации в браузере (мс)"
        },
        "freeAI.qwen.thinkingMode": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "description": "Режим thinking для Qwen: auto = выключать при tools, on = всегда включать, off = всегда выключать"
        },
        "freeAI.qwen.thinkingBudgetTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 256,
          "description": "Лимит токенов для thinking (используется когда thinking включен)"
        },
        "freeAI.deepseek.thinkingMode": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "description": "Режим thinking для DeepSeek: auto = выключать при tools, on = всегда включать, off = всегда выключать"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc --noEmit",
    "bundle": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "playwright": "^1.52.0"
  }
}
