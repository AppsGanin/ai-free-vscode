{
  "name": "dsh-plugin-free-ai",
  "version": "0.1.0",
  "description": "Qwen, DeepSeek, Kimi and Z.ai web chats as DeepSeek Harness model providers, signed in through your own browser account",
  "license": "MIT",
  "author": "AppsGanin",
  "homepage": "https://github.com/AppsGanin/ai-free-vscode/tree/main/dsh-plugin#readme",
  "repository": {
    "type": "git",
